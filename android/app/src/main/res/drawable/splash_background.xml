<?xml version="1.0" encoding="utf-8"?>
<!-- Window background shown before the React root view draws. Light/dark
     variants resolve via drawable-xxhdpi / drawable-night-xxhdpi twohops_splash.png
     (1080x1920 px = 360x640 dp, so the bitmap scales per density bucket). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/twohops_splash_background" />
    <!-- Centered, not stretched. Background color matches the splash edge,
         so taller/wider screens just get matching padding. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/twohops_splash" />
    </item>
</layer-list>
